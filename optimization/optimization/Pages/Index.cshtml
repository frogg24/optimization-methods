@page
@model IndexModel
@{
    ViewData["Title"] = "Оптимизация методом золотого сечения";
}

<link href="~/css/GoldenSection.css" rel="stylesheet" />

<div class="container-fluid px-4">
    <h1 class="my-4">Метод золотого сечения</h1>

    <div class="row g-4">
        <div class="col-lg-5">
            <form method="post">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Func" class="form-label">Функция</label>
                        <input asp-for="Func" type="text" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Left" class="form-label">Левая граница (a)</label>
                        <input asp-for="Left" type="number" step="any" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Right" class="form-label">Правая граница (b)</label>
                        <input asp-for="Right" type="number" step="any" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Epsilon" class="form-label">Точность (ε)</label>
                        <input asp-for="Epsilon" type="number" step="any" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Mode" class="form-label">Цель оптимизации</label>
                        <select asp-for="Mode" class="form-select">
                            <option value="Min">Поиск минимума</option>
                            <option value="Max">Поиск максимума</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" name="action" asp-page-handler="Calculate" class="btn btn-primary">
                            Выполнить оптимизацию
                        </button>
                        <button type="submit" name="action" value="Reset" class="btn btn-outline-secondary">
                            Сбросить
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-7">
            <div class="border rounded p-3 h-100">
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Ошибка:</strong> @Model.Error
                    </div>
                }

                @if (Model.ResultX.HasValue && Model.ResultFx.HasValue)
                {
                    <div class="alert alert-success">
                        точка минимума функции: @Model.ResultX
                    </div>
                    <div class="alert alert-success">
                        значение функции в точке @Model.ResultFx
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.PlotJson))
                {
                    <div id="plot" style="width: 100%; height: 520px;"></div>

                    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
                    <script>
                        const data = @Html.Raw(Model.PlotJson);

                        const curve = {
                            x: data.xs,
                            y: data.ys,
                            mode: 'lines',
                            name: 'f(x)',
                            line: { color: '#1f77b4', width: 2 },
                            connectgaps: false
                        };

                        const minPoint = {
                            x: [data.xMin],
                            y: [data.fMin],
                            mode: 'markers',
                            name: 'минимум',
                            marker: { color: 'red', size: 12 }
                        };

                        const layout = {
                            title: 'Метод золотого сечения',
                            xaxis: { title: 'x' },
                            yaxis: { title: 'f(x)' },
                            hovermode: 'closest',
                            shapes: [{
                                type: 'line',
                                xref: 'x', yref: 'paper',
                                x0: data.xMin, x1: data.xMin,
                                y0: 0, y1: 1,
                                line: { color: 'green', width: 1.5, dash: 'dash' }
                            }]
                        };

                        Plotly.newPlot('plot', [curve, minPoint], layout, {
                            responsive: true,
                            scrollZoom: true
                        });
                    </script>
                }
            </div>
        </div>
    </div>
</div>